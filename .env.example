# =============================================================
# Huza Frontend — Environment Variables
# =============================================================
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored; only this example is committed.
# =============================================================

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3003

# Socket.io server URL (usually same as API)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3003

# Public URLs. All optional — production defaults are built in.
# The app host (defaults to https://app.huza.app)
NEXT_PUBLIC_APP_URL=
# The marketing site (defaults to https://huza.app)
NEXT_PUBLIC_MARKETING_URL=
# Canonical origin for metadata / OG image URLs (falls back to the Vercel URL)
NEXT_PUBLIC_SITE_URL=

# Web push (Firebase Cloud Messaging). Without it, push is simply disabled.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Umami analytics. Without a website id, analytics are off.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=

# Feature flags ------------------------------------------------
# Guest browsing: guests can browse home + detail pages without an account,
# and commitment actions prompt sign-in. Unset/false keeps the auth-gated flow.
NEXT_PUBLIC_GUEST_BROWSING=false
